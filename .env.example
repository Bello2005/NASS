# --- Mapa -------------------------------------------------------------------
# Clave de los basemaps de CARTO. Sin ella las teselas salen con la marca de
# agua "API KEY REQUIRED". Se obtiene en https://carto.com/
#
# IMPORTANTE: las variables NEXT_PUBLIC_* se incrustan al COMPILAR. Define la
# clave ANTES de ejecutar `npm run build`, o el mapa saldrá igual con marca de
# agua aunque la clave esté puesta.
#
# La clave viaja al navegador, como toda clave de mapa del lado del cliente.
# No se protege ocultándola, sino restringiéndola por dominio desde el panel
# de CARTO.
NEXT_PUBLIC_CARTO_API_KEY=

# Estilo del basemap. `dark_all` es el que corresponde a la interfaz del C4.
# Otros: voyager, positron, dark_nolabels.
NEXT_PUBLIC_CARTO_STYLE=dark_all

# --- Seguridad --------------------------------------------------------------
# Secreto para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin él, en desarrollo se genera uno efímero por proceso: las sesiones se
# cierran cada vez que reinicias el servidor.
NASS_AUTH_SECRET=

# --- Simulador --------------------------------------------------------------
# Simulador de GPS de unidades. "off" lo desactiva por completo.
NASS_SIMULATOR=on

# Velocidad de desplazamiento de las unidades simuladas, en km/h.
NASS_SIM_SPEED_KMH=55
